{
  "openapi": "3.1.1",
  "info": {
    "title": "Margen",
    "description": "Asistente financiero personal. Todos los montos viajan como entero de centavos; el servidor no emite decimales en ningún camino monetario.",
    "version": "v1"
  },
  "paths": {
    "/dashboard": {
      "get": {
        "tags": [
          "Panel"
        ],
        "summary": "La única pregunta: cuánto puedo gastar sin afectar mis compromisos.",
        "operationId": "GetDashboard",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/transactions/cash": {
      "post": {
        "tags": [
          "Efectivo"
        ],
        "operationId": "CreateCashTransaction",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCashRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/reconciliation": {
      "get": {
        "tags": [
          "Conciliación"
        ],
        "operationId": "GetReconciliation",
