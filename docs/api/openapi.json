    "/notifications": {
      "get": {
        "tags": [
          "Avisos"
        ],
        "operationId": "ListNotifications",
        "parameters": [
          {
            "name": "includeResolved",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/notifications/{id}/resolve": {
      "post": {
        "tags": [
          "Avisos"
        ],
        "operationId": "ResolveNotification",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rules": {
      "get": {
        "tags": [
          "Reglas"
        ],
        "operationId": "ListRules",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      },
      "post": {
        "tags": [
          "Reglas"
        ],
        "operationId": "CreateRule",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRuleRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/rules/{id}": {
      "delete": {
        "tags": [
          "Reglas"
        ],
        "operationId": "DeleteRule",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/emails": {
      "get": {
        "tags": [
          "Correos entrantes"
        ],
        "operationId": "ListIncomingEmails",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChallengeRequest": {
        "required": [
          "deviceId"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "CreateCashRequest": {
        "required": [
          "amountCents",
          "merchant",
          "categoryId",
          "occurredOn",
          "notes"
        ],
        "type": "object",
        "properties": {
          "amountCents": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "merchant": {
            "type": "string"
          },
          "categoryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "occurredOn": {
            "type": [
              "null",
              "string"
            ],
            "format": "date"
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CreateRuleRequest": {
        "required": [
          "pattern",
          "matchKind",
          "categoryId"
        ],
        "type": "object",
        "properties": {
          "pattern": {
            "type": "string"
          },
          "matchKind": {
            "type": "string"
          },
          "categoryId": {
            "type": "string",
            "format": "uuid"
          },
          "weight": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32",
            "default": 100
          }
        }
      },
      "PutTransactionRequest": {
        "required": [
          "categoryId",
          "status",
          "notes"
        ],
        "type": "object",
        "properties": {
          "categoryId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "status": {
            "type": [
              "null",
              "string"
            ]
          },
          "notes": {
            "type": [
              "null",
              "string"
            ]
          },
          "createRule": {
            "type": "boolean",
            "default": false
          }
        }
      },
      "RedeemRequest": {
        "required": [
          "deviceId",
          "nonce",
          "signature"
        ],
        "type": "object",
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "nonce": {
            "type": "string"
          },
          "signature": {
            "type": "string"
          }
        }
      },
      "RedistributeRequest": {
        "required": [
          "fromCategoryId",
          "toCategoryId",
          "amountCents"
        ],
        "type": "object",
        "properties": {
          "fromCategoryId": {
            "type": "string",
            "format": "uuid"
          },
          "toCategoryId": {
            "type": "string",
            "format": "uuid"
          },
          "amountCents": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          }
        }
      },
      "RegisterDeviceRequest": {
        "required": [
          "name",
          "publicKeySpki"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "publicKeySpki": {
            "type": "string"
          }
        }
      },
      "ShortcutTokenRequest": {
        "required": [
          "label"
        ],
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          }
        }
      }
    }
  },
