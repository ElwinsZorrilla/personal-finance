# Copiar a .env y completar. .env está en .gitignore y no se sube nunca.

REGISTRY=ghcr.io/tuusuario
TAG=latest

# Red externa a la que ya está conectado Nginx Proxy Manager.
# Verificar con: docker network ls
PROXY_NETWORK=nginxproxymanager_default

POSTGRES_DB=margen
POSTGRES_USER=margen
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Código que hay que presentar para dar de alta un teléfono. Se usa una vez, al
# instalar la app, y conviene rotarlo después. Vacío = el alta responde 503.
# openssl rand -base64 24
AUTH_ENROLLMENT_CODE=

# Buzón exclusivo de notificaciones bancarias.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=finanzas@tudominio.com
IMAP_PASSWORD=
# Lista separada por comas. El worker descarta todo lo demás sin leerlo.
IMAP_ALLOWED_SENDERS=alertas@tubanco.com,notificaciones@tubanco.com

# Ruta en el host para los respaldos. Debe estar fuera del volumen de Docker.
BACKUP_PATH=/srv/backups/margen
