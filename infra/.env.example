# Copiar a .env y completar. .env está en .gitignore y no se sube nunca.

REGISTRY=ghcr.io/tuusuario
TAG=latest

# Red externa a la que ya está conectado Nginx Proxy Manager.
# Verificar con: docker network ls
PROXY_NETWORK=nginxproxymanager_default

POSTGRES_DB=margen
POSTGRES_USER=margen
# openssl rand -base64 32
POSTGRES_PASSWORD=

# Código que hay que presentar para dar de alta un teléfono. Se usa una vez, al
# instalar la app, y conviene rotarlo después. Vacío = el alta responde 503.
# openssl rand -base64 24
AUTH_ENROLLMENT_CODE=

# Buzón exclusivo de notificaciones bancarias.
# Con Gmail: imap.gmail.com, y la contraseña es una CONTRASEÑA DE APLICACIÓN,
# no la de la cuenta. Pasos en docs/gmail.md.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=finanzas@tudominio.com
IMAP_PASSWORD=
# Lista separada por comas. El worker descarta todo lo demás sin leerlo, y sin
# lista no lee nada. Vale la dirección completa o el dominio.
IMAP_ALLOWED_SENDERS=alertas@tubanco.com,notificaciones@tubanco.com

# Solo para capturar muestras: los nombres que el redactor tiene que quitar.
# No hace falta en producción.
MUESTRAS_DATOS_PERSONALES=

# Ruta en el host para los respaldos. Debe estar fuera del volumen de Docker.
BACKUP_PATH=/srv/backups/margen

# Respaldos. La ruta del host donde se guardan los dump; ponla en un disco
# distinto del de la base si puedes, que un respaldo en el mismo disco no
# protege de que se rompa el disco.
BACKUP_PATH=
# Días que se conservan.
BACKUP_RETENTION_DAYS=14
# Cada cuántos respaldos se verifica la restauración en una base descartable.
# 7 = una vez por semana con respaldos diarios.
BACKUP_VERIFY_EVERY=7
