<Project Sdk="Microsoft.NET.Sdk">

  <!-- Lógica pura de ingesta: normalización, huella y detección de duplicados.
       Sin IMAP y sin base de datos, para que el camino entero se pueda probar
       con muestras sintéticas antes de que exista un correo real del banco. -->

  <ItemGroup>
    <ProjectReference Include="../Margen.Domain/Margen.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- `ResolveInstant` y `ParseMoney` son las dos piezas del parser que hay
         que poder probar con números concretos y sin montar un correo entero.
         Sacarlas a públicas sería ampliar la superficie del ensamblado por
         comodidad de las pruebas. -->
    <InternalsVisibleTo Include="Margen.Ingest.Tests" />
  </ItemGroup>

</Project>
